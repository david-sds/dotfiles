# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Fzf colors (Gruvbox Material)
color00='#32302f'
color01='#3c3836'
color02='#504945'
color03='#665c54'
color04='#bdae93'
color05='#d5c4a1'
color06='#ebdbb2'
color07='#fbf1c7'
color08='#fb4934'
color09='#fe8019'
color0A='#fabd2f'
color0B='#b8bb26'
color0C='#8ec07c'
color0D='#83a598'
color0E='#d3869b'
color0F='#d65d0e'
export FZF_DEFAULT_OPTS="
  --color=bg:-1
  --color=bg+:$color01
  --color=fg:$color04
  --color=fg+:$color06
  --color=hl:$color0B
  --color=hl+:$color08
  --color=info:$color0A
  --color=prompt:$color0A
  --color=pointer:$color08
  --color=marker:$color08
  --color=spinner:$color0C
  --color=header:$color0D
  --color=border:$color02
  --color=label:$color03
  --color=query:$color06
  --color=gutter:$color01
"

# Exec Tmux on every session
if command -v tmux &>/dev/null && [[ -z $TMUX && -z $NVIM && -z $SSH_CONNECTION ]]; then
  exec tmux
fi

# Pane title (tmux pane-border-format)
if [[ -z $__title_init ]]; then
  __title_init=1
  __title() { printf '\e]0;%s@%s:%s%s\a' "$USER" "${HOSTNAME%%.*}" "${PWD/#$HOME/\~}" "${1:+ $1}"; }
  PROMPT_COMMAND=('__title_live=' "${PROMPT_COMMAND[@]}" '__title')
  PS0+='${__title_live[__title_live=1]}'
  trap '[[ $__title_live && $BASH_COMMAND != __title_live= ]] && __title "$BASH_COMMAND"' DEBUG
fi

# Aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# Functions
o() { (xdg-open "$@" >/dev/null 2>&1 &) }

# Show git branch name
source /usr/share/git/completion/git-prompt.sh
BLUE="\[\e[34m\]"
GREEN="\[\e[32m\]"
RED="\[\e[31m\]"
WHITE="\[\e[37m\]"
RESET="\[\e[0m\]"
export PS1="$BLUE \W $RESET\$(__git_ps1 \"$GREEN($RED%s$GREEN)$RESET\")$WHITE\$$RESET "

# System variables
export EDITOR='nvim -u ~/.config/nvim/minimal.lua'
export VISUAL="$EDITOR"
export TERMINAL="alacritty"
# System paths
export XCOMPOSEFILE="$HOME/.XCompose"
export HYPRSHOT_DIR="$HOME/Pictures/Screenshots/"
# Keys
export OPENROUTER_API_KEY="https://openrouter.ai/settings/keys"
# Development
export CHROME_EXECUTABLE="/usr/bin/chromium"
export CACHE_PATH="$HOME/Cache"
export GOPATH="$CACHE_PATH/go"
export PATH="$GOPATH/bin:$PATH"
export FVM_CACHE_PATH="$CACHE_PATH/fvm"
export SDKMAN_DIR="$HOME/.sdkman"
export CODEX_HOME="$HOME/.config/codex"
export ANDROID_HOME=$HOME/Android/Sdk # Change to /opt/android-sdk if using AUR
export ANDROID_SDK_ROOT=$ANDROID_HOME
# Path variable
export PATH="$HOME/.local/bin:$PATH"
export PATH="$CACHE_PATH/fvm/default/bin:$CACHE_PATH/fvm/default/bin/cache/dart-sdk/bin/:$PATH"
export PATH="$HOME/.local/share/nvim/mason/bin:$PATH"
export PATH="$PATH:$ANDROID_HOME/emulator"
export PATH="$PATH:$ANDROID_HOME/platform-tools"
export PATH="$PATH:$ANDROID_HOME/cmdline-tools/latest/bin"
export PATH=/home/david/.opencode/bin:$PATH

export QT_QPA_PLATFORM=wayland
export XDG_CURRENT_DESKTOP=Hyprland

# Fzf key bindings (C-t, C-r, M-c) and completion
command -v fzf &>/dev/null && eval "$(fzf --bash)"

# NVM Config
[[ -s "/usr/share/nvm/init-nvm.sh" ]] && source /usr/share/nvm/init-nvm.sh

# SDKMAN Config (Must be at the end of the file)
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

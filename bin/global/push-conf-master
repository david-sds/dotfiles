#!/usr/bin/env bash

set -e
cd "$HOME/Core/dotfiles"

WORKTREE="${TMPDIR:-/tmp}/push-conf-master.$$"
trap \
  'printf "push-conf-master failed. Worktree (if any): %s\n" "$WORKTREE" >&2' \
  ERR

if [ -z "$(git status --porcelain --ignore-submodules=dirty)" ]; then
  echo "Nothing to publish."
  exit 0
fi

git fetch origin master
if [ "$(git rev-list --count origin/master..master)" -ne 0 ]; then
  echo "Local master has unpushed commits."
  exit 1
fi

# Init variables
BRANCH=$(git branch --show-current)
TIMESTAMP=$(printf '%(%Y-%m-%d %H:%M:%S)T' -1)

# Commit changes
git add -A
git commit -m "$BRANCH push-conf-master at $TIMESTAMP"
COMMIT=$(git rev-parse HEAD)

# Master's temporary Worktree
git worktree add -B master "$WORKTREE" origin/master

# Updates master
git -C "$WORKTREE" cherry-pick "$COMMIT"
git -C "$WORKTREE" push

# Update current branch
git merge origin/master --no-edit
git push

# Remove temporary Worktree
git worktree remove --force "$WORKTREE"

# Reload stuff
if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload || true
fi

if command -v tmux >/dev/null 2>&1; then
  tmux source-file ~/.config/tmux/tmux.conf || true
fi

if command -v omarchy >/dev/null 2>&1; then
  omarchy restart shell || true
fi

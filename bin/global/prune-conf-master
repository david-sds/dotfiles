#!/usr/bin/env bash

set -e
cd "$HOME/Core/dotfiles"

# Remove leftover worktrees from failed push-conf-master runs
rm -rf "${TMPDIR:-/tmp}"/push-conf-master.*
git worktree prune

# Reset current branch to its remote; master's changes come back via pull
BRANCH=$(git branch --show-current)
git fetch origin master "$BRANCH"

# Abort if resetting would lose anything: replaying the unpushed changes onto master must leave it unchanged
REPLAYED=$(git merge-tree --write-tree --merge-base="origin/$BRANCH" origin/master HEAD | head -1)
if [ "$REPLAYED" != "$(git rev-parse 'origin/master^{tree}')" ]; then
  echo "Unpushed changes not on master, not resetting:" >&2
  git log --oneline "origin/$BRANCH..HEAD" >&2
  exit 1
fi

git reset --keep "origin/$BRANCH"

pull-conf-master
